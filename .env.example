# ======================= BitPoin (BTP) =======================
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا ترفع ملف .env إلى Git أبداً.

# توكن بوت تلجرام (من @BotFather)
BOT_TOKEN=9107523489:AAHYcbn_vJrKau40H0xQc6JCyYSd8MyaxqI

# اسم البوت بدون @ (يُستخدم في توجيه أوامر القروبات مثل /balance@Bitpoin_bot)
BOT_USERNAME=Bitpoin_bot

# اتصال PostgreSQL. مثال محلي: postgres://user:pass@localhost:5432/bitpoin
# اتركه فارغاً لاستخدام قاعدة PGlite المدمجة (للتطوير فقط)
DATABASE_URL=

# سر توقيع JWT — استخدم سلسلة عشوائية طويلة (openssl rand -hex 48)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# معرّفات تلجرام للمديرين مفصولة بفواصل
ADMIN_IDS=123456789

# كلمة سر لوحة الأدمن الاحتياطية (اختياري — تُستخدم لتسجيل دخول مدير عبر /admin/login)
ADMIN_PASSWORD=

# ======================= الخادم =======================
PORT=3000
APP_URL=https://your-domain.example

# عرض تجريبي: يفعّل زر دخول سريع (لا يعمل في الإنتاج)
DEMO_MODE=true

# ⚠️ خطر أمني: يسمح بالدخول التجريبي حتى في الإنتاج (بيئات المعاينة فقط — أطفئه قبل النشر)
DEMO_ALLOW_PRODUCTION=false

# ======================= بنية قاعدة البيانات (للتطوير فقط) =======================
# auto: تشغيل L2/Post-L1 --pglite إذا كان DATABASE_URL فارغاً
DB_ENGINE=auto

# ======================= Webhook =======================
# رابط عام (https) يستقبل تحديثات تلجرام. اتركه فارغاً → polling (تطوير فقط)
WEBHOOK_SECRET=change_me_webhook_secret
TELEGRAM_WEBHOOK_URL=

# ======================= نسخ احتياطي =======================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_DIR=./backups
BACKUP_KEEP=14
