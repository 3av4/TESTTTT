    "db:restore": "tsx scripts/restore.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "bot:setup": "tsx scripts/set-webhook.ts",
    "bot:delete": "tsx scripts/delete-webhook.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "bot:simulate": "tsx scripts/simulate-bot.ts",
