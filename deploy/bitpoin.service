# systemd: /etc/systemd/system/bitpoin.service
[Unit]
Description=BitPoin (BTP) — website + Telegram bot
After=network.target postgresql.service

[Service]
Type=simple
User=bitpoin
WorkingDirectory=/opt/bitpoin
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npx tsx server.ts
Restart=always
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
